{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.internal/cdm/commerce/bank-transfer-payment.schema.json",
  "title": "BankTransferPayment",
  "description": "A payment made by direct bank transfer.",
  "allOf": [
    {
      "$ref": "payment.schema.json"
    }
  ],
  "type": "object",
  "required": [
    "bsb"
  ],
  "properties": {
    "method": {
      "const": "bank_transfer"
    },
    "bsb": {
      "type": "string",
      "pattern": "^\\d{6}$"
    },
    "accountLast4": {
      "type": "string",
      "pattern": "^\\d{4}$"
    }
  }
}
