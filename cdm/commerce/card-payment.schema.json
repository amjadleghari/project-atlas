{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.internal/cdm/commerce/card-payment.schema.json",
  "title": "CardPayment",
  "description": "A payment made with a debit or credit card.",
  "allOf": [
    {
      "$ref": "payment.schema.json"
    }
  ],
  "type": "object",
  "required": [
    "cardBrand",
    "last4"
  ],
  "properties": {
    "method": {
      "const": "card"
    },
    "cardBrand": {
      "type": "string",
      "enum": [
        "VISA",
        "MASTERCARD",
        "AMEX"
      ]
    },
    "last4": {
      "type": "string",
      "pattern": "^\\d{4}$"
    }
  }
}
