    "@docusaurus/theme-mermaid": "^3.10.2",
    "@docusaurus/utils": "^3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "cytoscape": "^3.34.4",
    "cytoscape-elk": "^2.3.0",
