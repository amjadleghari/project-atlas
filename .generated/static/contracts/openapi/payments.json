{
  "openapi": "3.1.0",
  "info": {
    "title": "Payments API",
    "version": "2.0.0",
    "summary": "Take payments against orders.",
    "description": "Internal contract for the Payments service.\n\nOwned by **Team Payments** · Slack `#team-payments`\n\nPayload schemas come from the [canonical data model](../data-model?model=Payment).",
    "contact": {
      "name": "Team Payments",
      "email": "payments@example.internal"
    },
    "license": {
      "name": "Proprietary",
      "identifier": "LicenseRef-Proprietary"
    }
  },
  "servers": [
    {
      "url": "https://payments.api.example.internal/v2",
      "description": "Production"
    }
  ],
  "security": [
    {
      "oauth2": [
        "payments:write"
      ]
    }
  ],
  "tags": [
    {
      "name": "Payments",
      "description": "Payment authorisation and capture."
    }
  ],
  "paths": {
    "/payments": {
      "post": {
        "tags": [
          "Payments"
        ],
        "operationId": "createPayment",
        "summary": "Create a payment for an order",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewPayment"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Payment created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request."
          },
          "401": {
            "description": "Unauthorised."
          }
        }
      }
    },
    "/payments/{paymentId}/capture": {
      "post": {
        "tags": [
          "Payments"
        ],
        "operationId": "capturePayment",
        "summary": "Capture an authorised payment",
        "parameters": [
          {
            "name": "paymentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Payment captured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorised."
          },
          "409": {
            "description": "Payment is not in an authorised state."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://auth.example.internal/oauth2/token",
            "scopes": {
              "payments:write": "Create and capture payments"
            }
          }
        }
      }
    },
    "schemas": {
      "NewPayment": {
        "type": "object",
        "required": [
          "orderId",
          "amount",
          "method"
        ],
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "$ref": "#/components/schemas/money.schema"
          },
          "method": {
            "type": "string",
            "enum": [
              "card",
              "bank_transfer"
            ]
          }
        }
      },
      "Payment": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/card-payment.schema"
          },
          {
            "$ref": "#/components/schemas/bank-transfer-payment.schema"
          }
        ],
        "discriminator": {
          "propertyName": "method",
          "mapping": {
            "card": "#/components/schemas/card-payment.schema",
            "bank_transfer": "#/components/schemas/bank-transfer-payment.schema"
          }
        }
      },
      "money.schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://schemas.example.internal/cdm/core/money.schema.json",
        "title": "Money",
        "description": "A monetary amount in a specific currency. Amounts are decimal strings to avoid floating-point rounding.",
        "type": "object",
        "required": [
          "amount",
          "currency"
        ],
        "properties": {
          "amount": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d{1,4})?$",
            "description": "Decimal amount.",
            "examples": [
              "49.90"
            ]
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "ISO 4217 currency code.",
            "examples": [
              "AUD"
            ]
          }
        }
      },
      "entity.schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://schemas.example.internal/cdm/core/entity.schema.json",
        "title": "Entity",
        "description": "Base for every identifiable business object. Supplies identity and audit timestamps.",
        "x-abstract": true,
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Immutable, globally unique identifier.",
            "readOnly": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "description": "When the record was created (UTC)."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "description": "When the record was last changed (UTC)."
          }
        }
      },
      "payment.schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://schemas.example.internal/cdm/commerce/payment.schema.json",
        "title": "Payment",
        "description": "Money taken against an order. Concrete payments are card or bank transfer.",
        "x-abstract": true,
        "allOf": [
          {
            "$ref": "#/components/schemas/entity.schema"
          }
        ],
        "type": "object",
        "required": [
          "orderId",
          "amount",
          "status",
          "method"
        ],
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid",
            "x-references": "order.schema.json"
          },
          "amount": {
            "$ref": "#/components/schemas/money.schema"
          },
          "status": {
            "type": "string",
            "enum": [
              "AUTHORISED",
              "CAPTURED",
              "DECLINED"
            ]
          },
          "method": {
            "type": "string",
            "enum": [
              "card",
              "bank_transfer"
            ],
            "description": "Discriminator for the concrete payment type."
          }
        }
      },
      "card-payment.schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://schemas.example.internal/cdm/commerce/card-payment.schema.json",
        "title": "CardPayment",
        "description": "A payment made with a debit or credit card.",
        "allOf": [
          {
            "$ref": "#/components/schemas/payment.schema"
          }
        ],
        "type": "object",
        "required": [
          "cardBrand",
          "last4"
        ],
        "properties": {
          "method": {
            "const": "card"
          },
          "cardBrand": {
            "type": "string",
            "enum": [
              "VISA",
              "MASTERCARD",
              "AMEX"
            ]
          },
          "last4": {
            "type": "string",
            "pattern": "^\\d{4}$"
          }
        }
      },
      "bank-transfer-payment.schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://schemas.example.internal/cdm/commerce/bank-transfer-payment.schema.json",
        "title": "BankTransferPayment",
        "description": "A payment made by direct bank transfer.",
        "allOf": [
          {
            "$ref": "#/components/schemas/payment.schema"
          }
        ],
        "type": "object",
        "required": [
          "bsb"
        ],
        "properties": {
          "method": {
            "const": "bank_transfer"
          },
          "bsb": {
            "type": "string",
            "pattern": "^\\d{6}$"
          },
          "accountLast4": {
            "type": "string",
            "pattern": "^\\d{4}$"
          }
        }
      }
    }
  }
}
