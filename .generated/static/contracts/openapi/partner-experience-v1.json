{
  "openapi": "3.1.0",
  "info": {
    "title": "Partner Experience API",
    "version": "1.4.0",
    "summary": "Quote, issue and service annuities on behalf of partner customers.",
    "description": "The **master** Partner Experience API. Partners never consume this file\ndirectly: each partner's contract is generated from it by applying that\npartner's OpenAPI Overlay (see `partner-experience/partners/<partner>/overlays`).\n\nMoney and address payloads come from the [canonical data model](../../data-model?model=Money).\n",
    "contact": {
      "name": "Partner Integrations",
      "email": "partner-integrations@example.internal"
    },
    "license": {
      "name": "Proprietary",
      "identifier": "LicenseRef-Proprietary"
    }
  },
  "servers": [
    {
      "url": "https://partners.api.example.internal/experience/v1",
      "description": "Master gateway (replaced per partner by overlays)"
    }
  ],
  "security": [
    {
      "oauth2": [
        "quotes:write",
        "policies:read"
      ]
    }
  ],
  "tags": [
    {
      "name": "Quotes",
      "description": "Indicative annuity quotes."
    },
    {
      "name": "Policies",
      "description": "Issue and read annuity policies."
    },
    {
      "name": "Income",
      "description": "Scheduled income payments."
    }
  ],
  "paths": {
    "/quotes": {
      "post": {
        "tags": [
          "Quotes"
        ],
        "operationId": "createQuote",
        "summary": "Request an annuity quote",
        "description": "Returns an indicative quote valid for 14 days.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuoteRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Quote created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnnuityQuote"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/quotes/{quoteId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/QuoteId"
        }
      ],
      "get": {
        "tags": [
          "Quotes"
        ],
        "operationId": "getQuote",
        "summary": "Get a quote",
        "responses": {
          "200": {
            "description": "The quote.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnnuityQuote"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/policies": {
      "post": {
        "tags": [
          "Policies"
        ],
        "operationId": "createPolicy",
        "summary": "Issue a policy from an accepted quote",
        "security": [
          {
            "oauth2": [
              "policies:write"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PolicyRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Policy issued (status PENDING until funds clear).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Policy"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/policies/{policyId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/PolicyId"
        }
      ],
      "get": {
        "tags": [
          "Policies"
        ],
        "operationId": "getPolicy",
        "summary": "Get a policy",
        "responses": {
          "200": {
            "description": "The policy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Policy"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/policies/{policyId}/income-schedule": {
      "parameters": [
        {
          "$ref": "#/components/parameters/PolicyId"
        }
      ],
      "get": {
        "tags": [
          "Income"
        ],
        "operationId": "getIncomeSchedule",
        "summary": "Get the income payment schedule",
        "responses": {
          "200": {
            "description": "Past and upcoming income payments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncomeSchedule"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://auth.example.internal/oauth2/token",
            "scopes": {
              "quotes:write": "Create quotes",
              "policies:read": "Read policies",
              "policies:write": "Issue policies"
            }
          }
        }
      }
    },
    "parameters": {
      "QuoteId": {
        "name": "quoteId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "examples": [
            "qte_7Hd2kL"
          ]
        }
      },
      "PolicyId": {
        "name": "policyId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "examples": [
            "pol_93KsQa"
          ]
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "Error in RFC 9457 problem-details format.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "QuoteRequest": {
        "type": "object",
        "required": [
          "productType",
          "purchaseAmount",
          "annuitant",
          "paymentFrequency"
        ],
        "properties": {
          "productType": {
            "type": "string",
            "enum": [
              "LIFETIME",
              "FIXED_TERM",
              "DEFERRED_LIFETIME"
            ],
            "description": "Annuity product."
          },
          "termYears": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "Required for FIXED_TERM."
          },
          "purchaseAmount": {
            "$ref": "#/components/schemas/money.schema"
          },
          "paymentFrequency": {
            "type": "string",
            "enum": [
              "MONTHLY",
              "QUARTERLY",
              "HALF_YEARLY",
              "ANNUALLY"
            ]
          },
          "indexation": {
            "type": "string",
            "enum": [
              "NONE",
              "CPI",
              "FIXED_3"
            ],
            "default": "NONE"
          },
          "annuitant": {
            "$ref": "#/components/schemas/Annuitant"
          }
        }
      },
      "Annuitant": {
        "type": "object",
        "required": [
          "dateOfBirth",
          "sex"
        ],
        "properties": {
          "dateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "sex": {
            "type": "string",
            "enum": [
              "FEMALE",
              "MALE"
            ],
            "description": "Used for mortality pricing only."
          },
          "residentialAddress": {
            "$ref": "#/components/schemas/address.schema"
          }
        }
      },
      "AnnuityQuote": {
        "type": "object",
        "required": [
          "id",
          "status",
          "productType",
          "purchaseAmount",
          "incomeAmount",
          "paymentFrequency",
          "expiresAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "examples": [
              "qte_7Hd2kL"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "INDICATIVE",
              "ACCEPTED",
              "EXPIRED"
            ]
          },
          "productType": {
            "type": "string",
            "enum": [
              "LIFETIME",
              "FIXED_TERM",
              "DEFERRED_LIFETIME"
            ]
          },
          "purchaseAmount": {
            "$ref": "#/components/schemas/money.schema"
          },
          "incomeAmount": {
            "$ref": "#/components/schemas/money.schema"
          },
          "paymentFrequency": {
            "type": "string",
            "enum": [
              "MONTHLY",
              "QUARTERLY",
              "HALF_YEARLY",
              "ANNUALLY"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PolicyRequest": {
        "type": "object",
        "required": [
          "quoteId",
          "partnerReference"
        ],
        "properties": {
          "quoteId": {
            "type": "string"
          },
          "partnerReference": {
            "type": "string",
            "description": "The partner's own customer or account reference."
          }
        }
      },
      "Policy": {
        "type": "object",
        "required": [
          "id",
          "policyNumber",
          "status",
          "quoteId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "examples": [
              "pol_93KsQa"
            ]
          },
          "policyNumber": {
            "type": "string",
            "examples": [
              "ANN-00042317"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "ACTIVE",
              "CANCELLED"
            ]
          },
          "quoteId": {
            "type": "string"
          },
          "partnerReference": {
            "type": "string"
          },
          "commencementDate": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "IncomeSchedule": {
        "type": "object",
        "required": [
          "policyId",
          "payments"
        ],
        "properties": {
          "policyId": {
            "type": "string"
          },
          "payments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "date",
                "amount",
                "status"
              ],
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "amount": {
                  "$ref": "#/components/schemas/money.schema"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "SCHEDULED",
                    "PAID",
                    "FAILED"
                  ]
                }
              }
            }
          }
        }
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "money.schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://schemas.example.internal/cdm/core/money.schema.json",
        "title": "Money",
        "description": "A monetary amount in a specific currency. Amounts are decimal strings to avoid floating-point rounding.",
        "type": "object",
        "required": [
          "amount",
          "currency"
        ],
        "properties": {
          "amount": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d{1,4})?$",
            "description": "Decimal amount.",
            "examples": [
              "49.90"
            ]
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "ISO 4217 currency code.",
            "examples": [
              "AUD"
            ]
          }
        }
      },
      "address.schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://schemas.example.internal/cdm/core/address.schema.json",
        "title": "Address",
        "description": "A postal address.",
        "type": "object",
        "required": [
          "lines",
          "locality",
          "country"
        ],
        "properties": {
          "lines": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 3,
            "description": "Street lines."
          },
          "locality": {
            "type": "string",
            "description": "Suburb, town or city."
          },
          "region": {
            "type": "string",
            "description": "State or territory.",
            "examples": [
              "NSW"
            ]
          },
          "postcode": {
            "type": "string",
            "examples": [
              "2000"
            ]
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "ISO 3166-1 alpha-2 country code.",
            "examples": [
              "AU"
            ]
          }
        }
      }
    }
  }
}
